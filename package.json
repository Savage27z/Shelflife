{
  "name": "sourcecheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "How many NEAR contracts actually match their published source?",
  "license": "MIT",
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "check": "tsx src/cli.ts check",
    "typecheck": "tsc --noEmit",
    "verified": "tsx src/cli.ts verified",
    "enumerate": "tsx src/cli.ts enumerate",
    "weigh": "tsx src/cli.ts weigh",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "report": "tsx src/cli.ts report"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "bin": {
    "sourcecheck": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
